<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example.vat</groupId>
  <artifactId>vat-processing-service</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>VAT Processing Service</name>
  <description>Training project for a 2017-style enterprise Build and Release workflow.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <junit.version>4.12</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!--
    Maven deploy target.

    Set these environment variables before running mvn deploy:
      JFROG_URL=https://your-company.jfrog.io
      JFROG_RELEASE_REPO=libs-release-local
      JFROG_SNAPSHOT_REPO=libs-snapshot-local

    Credentials are intentionally NOT stored in pom.xml. They belong in
    Maven settings.xml; see config/settings-jfrog.xml.example.
  -->
  <distributionManagement>
    <repository>
      <id>jfrog-releases</id>
      <name>JFrog Artifactory Maven Releases</name>
      <url>${env.JFROG_URL}/artifactory/${env.JFROG_RELEASE_REPO}</url>
    </repository>
    <snapshotRepository>
      <id>jfrog-snapshots</id>
      <name>JFrog Artifactory Maven Snapshots</name>
      <url>${env.JFROG_URL}/artifactory/${env.JFROG_SNAPSHOT_REPO}</url>
    </snapshotRepository>
  </distributionManagement>

  <build>
    <finalName>vat-processing-service-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.7.0</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>2.20.1</version>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
          <excludes>
            <exclude>**/*IT.java</exclude>
          </excludes>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.0.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.example.vat.app.VatApplication</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>2.20.1</version>
        <configuration>
          <includes>
            <include>**/*IT.java</include>
          </includes>
          <systemPropertyVariables>
            <project.basedir>${project.basedir}</project.basedir>
            <project.build.directory>${project.build.directory}</project.build.directory>
            <project.build.finalName>${project.build.finalName}</project.build.finalName>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Explicitly pinned for the 2017-era training workflow. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <version>2.8.2</version>
      </plugin>
    </plugins>
  </build>
</project>
