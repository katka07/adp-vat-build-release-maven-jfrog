<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example.vat</groupId>
  <artifactId>vat-processing-service</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>VAT Processing Service</name>
  <description>Training project upgraded to modern Java 21 Build and Release workflow.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- FIX: Upgraded compiler source and target parameters to modern Java 21 release flags -->
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <maven.compiler.release>21</maven.compiler.release>
    <!-- FIX: Upgraded JUnit to modern production stable release -->
    <junit.version>4.13.2</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!--
    Maven deploy target.
    Set these environment variables before running mvn deploy:
      JFROG_URL=https://your-company.jfrog.io
      JFROG_RELEASE_REPO=libs-release-local
      JFROG_SNAPSHOT_REPO=libs-snapshot-local
  -->
  <distributionManagement>
    <repository>
      <id>jfrog-releases</id>
      <name>JFrog Artifactory Maven Releases</name>
      <url>${env.JFROG_URL}/artifactory/${env.JFROG_RELEASE_REPO}</url>
    </repository>
    <snapshotRepository>
      <id>jfrog-snapshots</id>
      <name>JFrog Artifactory Maven Snapshots</name>
      <url>${env.JFROG_URL}/artifactory/${env.JFROG_SNAPSHOT_REPO}</url>
    </snapshotRepository>
  </distributionManagement>

  <build>
    <finalName>vat-processing-service-${project.version}</finalName>
    <plugins>
      <!-- FIX: Upgraded Maven Compiler Plugin to handle Java 21 features -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
        </configuration>
      </plugin>

      <!-- FIX: Upgraded Surefire Plugin to bypass the 'JAVA_SPECIFICATION_VERSION_AS_ENUM' null pointer crash -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
          <excludes>
            <exclude>**/*IT.java</exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- FIX: Upgraded Jar Plugin to modern version -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.example.vat.app.VatApplication</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <!-- FIX: Upgraded Failsafe Plugin for stable integration tests on newer JDKs -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <includes>
            <include>**/*IT.java</include>
          </includes>
          <systemPropertyVariables>
            <project.basedir>${project.basedir}</project.basedir>
            <project.build.directory>${project.build.directory}</project.build.directory>
            <project.build.finalName>${project.build.finalName}</project.build.finalName>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- FIX: Upgraded Deploy Plugin to cleanly pass artifacts up to modern JFrog target endpoints -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <version>3.1.1</version>
      </plugin>
    </plugins>
  </build>
</project>
